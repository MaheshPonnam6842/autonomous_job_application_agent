# Copy to `.env` and adjust. All values are optional; defaults keep the agent
# runnable out of the box against a local Ollama server.

# --- LLM (local Ollama) ---
OLLAMA_HOST=http://localhost:11434
JOBAGENT_CHAT_MODEL=llama3.1:8b
JOBAGENT_REWRITE_MODEL=llama3.1:8b
JOBAGENT_EMBED_MODEL=nomic-embed-text
JOBAGENT_LLM_TIMEOUT=120
JOBAGENT_LLM_RETRIES=2
JOBAGENT_LLM_TEMPERATURE=0.2
# Set to 0 to force the deterministic, fully-offline path (used by tests).
JOBAGENT_LLM_ENABLED=1

# --- Scoring weights (auto-normalized) ---
JOBAGENT_W_SKILL=0.5
JOBAGENT_W_SEMANTIC=0.3
JOBAGENT_W_ATS=0.2

# --- Decision thresholds ---
JOBAGENT_REWRITE_THRESHOLD=0.75
JOBAGENT_MAX_MISSING_REQUIRED=1

# --- Paths / logging ---
JOBAGENT_ARTIFACTS_DIR=artifacts
JOBAGENT_LOG_LEVEL=INFO
